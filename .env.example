# Copy this file to .env and adjust values for your environment.
# The application reads configuration from environment variables only.
# Never commit a real .env file or real patient data credentials.

# SQLAlchemy database URL.
# Local prototype (default): SQLite file in the project root.
DATABASE_URL=sqlite:///icu_dashboard.db
#
# Neon (managed Postgres) -- get this from your Neon project's
# Dashboard > Connect, "Connection string" tab (use the *pooled*
# connection for an app like this, not the direct one). It always
# needs sslmode=require and the postgresql+psycopg2 driver prefix:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
#
# Any other PostgreSQL host works the same way, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/icu_dashboard

# Hour (0-23) that marks the start of a new "operational day" for discharge
# reporting. Discharges logged between 00:00 and this hour are treated as
# belonging to the previous operational day, and are flagged as
# early-morning discharges for manual review. See services/data_quality.py.
OPERATIONAL_DAY_CUTOFF_HOUR=6

# Set to "true" to re-seed the database with sample data on every startup
# (useful for demos). Leave "false" for a persistent local dataset.
ICU_RESEED_ON_START=false
